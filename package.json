{
  "name": "mostasas-rage",
  "version": "0.1.0",
  "description": "MOSTASA'S RAGE: CIUDAD DE LA FURIA — Beat'em up 2.5D web",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "jugar": "vite --open --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "sprites:process": "node scripts/process-sprites.mjs",
    "sprites:normalize": "node scripts/normalize-sprites.mjs",
    "sprites:build": "npm run sprites:process && npm run sprites:normalize",
    "sprites:v2:build": "node scripts/build-character-atlases.mjs",
    "sprites:v2:validate": "node scripts/validate-character-atlases.mjs",
    "objects:clean": "node scripts/clean-object-assets.mjs",
    "objects:validate": "node scripts/clean-object-assets.mjs --check",
    "assets:check": "npm run sprites:v2:validate && npm run objects:validate",
    "check": "npm run typecheck && npm run lint && npm run assets:check && npm run test && npm run build",
    "arte:pliego": "tsx scripts/build-art-brief.mts",
    "arte:validar": "tsx scripts/validate-parts.mts"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
